{
  "name": "sm-desktop",
  "version": "0.0.0",
  "main": "main.cjs",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "electron .",
    "build:desktop": "ng build --configuration production --base-href ./",
    "build:windows": "npm run build:desktop && electron-builder --win nsis --publish never"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },

  "build": {
    "appId": "com.shelfmanager.desktop",
    "productName": "Shelf Manager",
    "directories": {
        "output": "release"
    },
    "files": [
        "main.cjs",
        "dist/SM-Desktop/browser/**/*",
        "package.json"
    ],
    "win": {
        "target": "nsis",
        "icon": "public/icons/shelf_manager_white.ico"
    },
    "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true
    }
  }

}
